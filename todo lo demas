{% extends "base.html" %}
{% block titulo %}Inventario - Tienda de Juegos{% endblock %}
{% block contenido %}
    <h1>🎮 Inventario de la Tienda</h1>
    <p class="subtitulo">Administra el stock de videojuegos disponibles.</p>

    <div class="barra-superior">
        <form class="buscador" method="get" action="{{ url_for('index') }}">
            <input type="text" name="q" placeholder="Buscar juego..." value="{{ busqueda }}">
            <button class="boton secundario" type="submit">Buscar</button>
        </form>
        <a class="boton" href="{{ url_for('agregar') }}">+ Agregar juego</a>
    </div>

    {% if juegos %}
    <table>
        <thead>
            <tr>
                <th>Nombre</th>
                <th>Género</th>
                <th>Plataforma</th>
                <th>Precio</th>
                <th>Stock</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            {% for juego in juegos %}
            <tr>
                <td>{{ juego.nombre }}</td>
                <td>{{ juego.genero or "—" }}</td>
                <td>{{ juego.plataforma or "—" }}</td>
                <td>${{ "%.2f"|format(juego.precio) }}</td>
                <td class="{{ 'stock-bajo' if juego.stock <= 3 else '' }}">{{ juego.stock }}</td>
                <td class="acciones">
                    <a class="boton secundario" href="{{ url_for('editar', juego_id=juego.id) }}">Editar</a>
                    <form method="post" action="{{ url_for('eliminar', juego_id=juego.id) }}"
                          onsubmit="return confirm('¿Eliminar {{ juego.nombre }}?');">
                        <button class="boton peligro" type="submit">Eliminar</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
        </tbody>
    </table>
    {% else %}
        <div class="vacio">No hay juegos registrados todavía. ¡Agrega el primero!</div>
    {% endif %}
{% endblock %}
